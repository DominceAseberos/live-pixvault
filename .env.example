# Required server-side Upstash Redis connection
# Never prefix these with VITE_.
UPSTASH_REDIS_REST_URL="https://your-database.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_rest_token"

# Optional protected write endpoints
# POST /api/components and DELETE /api/components/:id remain disabled unless one is configured.
ADMIN_SECRET="generate-a-long-random-server-secret"
COMPONENT_WRITE_SECRET="generate-a-long-random-server-secret"

# Optional AI component generation
# /api/generate remains disabled unless both values are configured.
AI_DESIGNER_SECRET="generate-a-long-random-server-secret"
GROQ_API_KEY="your_groq_api_key"

# Legacy migration only. Do not deploy these to the browser or prefix them with VITE_.
# The original PIXVAULT Supabase project is no longer reachable as of 2026-08-29.
LEGACY_SUPABASE_URL=""
LEGACY_SUPABASE_ANON_KEY=""
